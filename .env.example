# Set these in Netlify > Project configuration > Environment variables.
# Generate ADMIN_PASSWORD_HASH and SESSION_SECRET with npm run admin:password.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. Maximum source file size; Cloudinary's account limit also applies.
MAX_UPLOAD_MB=100
# Optional. YouTube Data API v3 key, restricted to that API. Server use only.
YOUTUBE_API_KEY=
